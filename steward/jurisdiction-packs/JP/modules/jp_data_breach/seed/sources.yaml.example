sources:
  - id: appi-law
    title: "個人情報の保護に関する法律（平成15年法律第57号）"
    url: "https://laws.e-gov.go.jp/law/415AC0000000057"
    type: law
    articles: ["26条（漏えい等の報告等）", "150条（権限の委任）"]
    retrieved_on: "2026-09-24"
  - id: appi-enforcement-rules
    title: "個人情報の保護に関する法律施行規則（平成28年個人情報保護委員会規則第3号）"
    url: "https://laws.e-gov.go.jp/law/428M60020000003"
    type: regulation
    articles: ["7条（報告対象事態 · 3号括弧書は2024-04-01施行）", "8条（速報・確報・報告事項）", "9条（委託元への通知）", "10条（本人への通知）"]
    retrieved_on: "2026-09-24"
  - id: ppc-guideline-general
    title: "個人情報の保護に関する法律についてのガイドライン（通則編）"
    url: "https://www.ppc.go.jp/personalinfo/legal/guidelines_tsusoku/"
    type: guideline
    articles: ["3-5-3-1 報告対象事態", "3-5-3-3 速報（概ね3〜5日以内）", "3-5-3-4 確報（知った時点を1日目 · 休日繰延べ）", "3-5-3-5 委託元への通知", "3-5-4 本人への通知"]
    retrieved_on: "2026-09-24"
  - id: ppc-leak-action
    title: "漏えい等の対応とお役立ち資料（漏えい等報告フォーム）"
    url: "https://www.ppc.go.jp/personalinfo/legal/leakAction/"
    type: form
    notes: "報告は原則 PPC ウェブフォームへ人間が入力。マイナンバーを含む場合は別フォーム。"
    retrieved_on: "2026-09-24"
  - id: ppc-delegation
    title: "権限の委任について（権限委任先省庁と報告先）"
    url: "https://www.ppc.go.jp/personalinfo/legal/kengenInin/"
    type: guide
    notes: "委任先は毎年更新 — 報告前に最新を確認。自社の雇用管理情報・株主情報は PPC へ。"
    retrieved_on: "2026-09-24"
  - id: administrative-holidays-act
    title: "行政機関の休日に関する法律（昭和63年法律第91号）"
    url: "https://laws.e-gov.go.jp/law/363AC0000000091"
    type: law
    articles: ["1条1項（土日・祝日・12/29〜1/3）", "2条（期限の特例）"]
    retrieved_on: "2026-09-24"
  - id: cao-holidays
    title: "内閣府「国民の祝日」について（祝日 CSV）"
    url: "https://www8.cao.go.jp/chosei/shukujitsu/gaiyou.html"
    type: calendar
    retrieved_on: "2026-09-24"

forms:
  - id: form-breach-preliminary
    name: "漏えい等報告（速報）記載項目下書き"
    kind: preliminary
    template: templates/report-preliminary.md.example
    legal_basis: "施行規則8条1項（報告時点で把握している事項）"
  - id: form-breach-final
    name: "漏えい等報告（確報）記載項目下書き"
    kind: final
    template: templates/report-final.md.example
    legal_basis: "施行規則8条2項（全事項 · 未判明は判明次第追完）"
