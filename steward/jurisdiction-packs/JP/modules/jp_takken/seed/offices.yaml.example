# 事務所 · 専任の宅建士（架空例示 · L1）
# 宅建士は employee_id で参照（氏名・登録番号・住所は records/ 側 · L2）。
entity: "サンプル不動産株式会社"
as_of: "2026-09-24"
offices:
  - office_id: OFF-MAIN
    name: "本店（例示）"
    kind: main
    prefecture: "東京都"
    staff_count: 12                # 業務に従事する者（宅建士を含む）→ 専任 3 人以上（施行規則第15条の5の3）
    takkenshi:
      - employee_id: EMP-001
        dedicated: true
        card_expires_on: "2029-03-31"
      - employee_id: EMP-002
        dedicated: true
        card_expires_on: "2027-02-28"   # 6か月以内に満了 → warn（法定講習）
      - employee_id: EMP-003
        dedicated: true
        card_expires_on: "2030-01-31"
      - employee_id: EMP-004
        dedicated: false
        card_expires_on: "2026-08-31"   # 失効（非専任）→ warn
    sign_posted: true
    fee_table_posted: true
    ledger_kept: true
    employee_register_kept: true
    employee_certificates_issued: true
  - office_id: OFF-BR1
    name: "多摩支店（例示）"
    kind: branch
    prefecture: "東京都"
    staff_count: 6                 # 専任 2 人以上
    takkenshi_shortage_since: "2026-09-16"   # 抵触日 → 補充期限 2026-09-30（法第31条の3第3項）
    takkenshi:
      - employee_id: EMP-011
        dedicated: true
        card_expires_on: "2028-05-31"
      - employee_id: EMP-012
        dedicated: true
        card_expires_on: "2026-09-15"   # 失効（専任）→ fail · 有効な専任 1 人（検出用）
    sign_posted: true
    fee_table_posted: false        # 報酬額の掲示なし → fail（検出用 · 法第46条第4項）
    ledger_kept: true
    employee_register_kept: true
    # employee_certificates_issued: 未記録 → needs_review
