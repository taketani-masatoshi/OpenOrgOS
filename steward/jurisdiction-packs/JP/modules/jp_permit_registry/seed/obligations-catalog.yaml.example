    category: notification
    legal_basis: 個人情報保護法第28条

  - id: OBL-EMPLOYMENT-RULES
    permit_type_ids: [pt-employment-rules]
    title: 就業規則の届出・変更届
    category: notification
    frequency: 変更時
    legal_basis: 労働基準法第89条
