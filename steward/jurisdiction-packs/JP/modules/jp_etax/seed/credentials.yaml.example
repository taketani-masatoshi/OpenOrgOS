# Certificate location refs only. Never store PIN, password, PKCS#12 bytes, or private keys.
# Copy to gitignored data/etax/credentials/{test,production}.yaml on the operator host.
# The official NTA module (Windows COM nta.CLCXtxSigner / macOS CLISignature) prompts on the device.
schema_version: 1
# T-O4: test and production must use different certificate_ref values when both are set.
environments:
  test:
    certificate_ref: null
    csp_name: null
  production:
    certificate_ref: null
    csp_name: null
