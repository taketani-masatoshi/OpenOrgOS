# Gov Gateway sandbox URL overrides (source before orgos commands)
# Copy to tenants/{id}/.env or export in shell — do not commit real credentials.

# X-Road v7 Security Server base URL (no trailing slash)
export GOV_XROAD_SECURITY_SERVER_URL=https://ss-sandbox.example.ee

# Japan e-Gov central API base
export GOV_EGOV_API_BASE_URL=https://api-sandbox.example.go.jp

# Georgia 3G Gov Gateway base
export GOV_GE_API_BASE_URL=https://gateway-sandbox.example.ge

# Optional Bearer tokens for authenticated health (--live)
# export GOV_XROAD_TOKEN=
# export GOV_EGOV_TOKEN=
# export GOV_GE_TOKEN=

# Transport: live (default) or mock for offline CI
export GOV_GATEWAY_TRANSPORT=live
