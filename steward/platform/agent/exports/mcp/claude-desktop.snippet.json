{
  "mcpServers": {
    "orgos-steward": {
      "command": "npx",
      "args": [
        "--yes",
        "tsx",
        "src/cli.ts",
        "mcp",
        "start"
      ],
      "env": {
        "ORGOS_TENANT": "aiac",
        "ORGOS_MCP_TOKEN": "<generate: orgos mcp rotate-token>"
      }
    }
  }
}