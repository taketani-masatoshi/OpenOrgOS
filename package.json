{
  "name": "steward-os",
  "version": "0.2.0",
  "description": "Steward OS - Property Business Edition",
  "type": "module",
  "bin": {
    "steward": "./src/cli.ts"
  },
  "scripts": {
    "steward": "node --import tsx src/cli.ts",
    "validate": "node --import tsx src/cli.ts validate",
    "check": "npm run validate && npm run steward -- classification check",
    "daily": "npm run check && npm run steward -- dashboard && npm run steward -- io status && npm run validate -- --deps",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@independentsoft/msg": "^1.0.2",
    "commander": "^13.1.0",
    "pdfkit": "^0.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
