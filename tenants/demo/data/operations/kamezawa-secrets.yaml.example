# 亀沢旅館 — 機密（Git にコミットしない）
# セットアップ: cp kamezawa-secrets.yaml.example kamezawa-secrets.yaml
# 各 TBD / REPLACE_ME を実値に置換後、`npm run validate -- --warnings` で警告解消を確認。

smart_lock_code: "REPLACE_ME"
wifi_ssid: "REPLACE_ME"
wifi_password: "REPLACE_ME"
host_phone_24h: "REPLACE_ME"
host_phone_backup: "REPLACE_ME"
cleaning_vendor_line: "REPLACE_ME"
cleaning_vendor_phone: "TBD"
extinguisher_location: "玄関付近（消火器2本）"
breaker_location: "TBD（分電盤の場所を記入）"
water_shutoff: "TBD（止水栓の場所を記入）"
gas_meter_location: "TBD"
first_aid_location: "TBD（救急箱・常備薬の保管場所）"
emergency_contact_property_mgmt: "TBD"
ota_backup_contact: "info@malkk.com"
notes: |
  公開情報は kamezawa-public.yaml。本ファイルはゲスト向け PDF・OTA 自動応答にのみ使用。
  清掃業者（CTR-012）確定後に cleaning_vendor_* を更新。
