# mal Phase 4a — email_wire SMTP/IMAP pilot (L1 template)
# L2 secrets: deploy/mal-pilot/env/.env.mail-wire (ORGOS_SMTP_* · ORGOS_IMAP_*)
# Account: ai@malkk.com only

provider: smtp
from:
  name: "MAL KK Secretary"
  email: ai@malkk.com
smtp:
  host: sv16463.xserver.jp
  port: 587
  secure: false
receive:
  sync: imap
  imap_host: sv16463.xserver.jp
  imap_port: 993
  imap_mailbox: INBOX
  poll_interval_sec: 300
  triage_mode: rules
  auto_triage: true
  auto_wire_scan: true
  notify_high_priority: true
  ceo_question_mode: inline
wire_outbound:
  enabled: true
  from:
    name: "MAL Wire"
    email: ai@malkk.com
  smtp:
    host: sv16463.xserver.jp
    port: 587
    secure: false
  max_per_hour: 60
notes: |
  Phase 4a — SMTP/IMAP email_wire (Community Gmail OAuth is Phase 4b · deferred).
