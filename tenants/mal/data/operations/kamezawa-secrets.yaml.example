# 亀沢旅館 — 機密（Git にコミットしない）
# セットアップ: cp kamezawa-secrets.yaml.example kamezawa-secrets.yaml
# ローカルでは各 REPLACE_ME / ダミー値を実値に置換。本 example は Phase A デモ用プレースホルダ。

smart_lock_code: "REPLACE_ME"
wifi_ssid: "MAL-Kamezawa-Guest"
wifi_password: "REPLACE_ME"
host_phone_24h: "REPLACE_ME"
host_phone_backup: "REPLACE_ME"
cleaning_vendor_line: "@sumida-clean-demo"
cleaning_vendor_phone: "03-0000-0000"
extinguisher_location: "玄関付近（消火器2本）"
breaker_location: "1F 廊下分電盤（デモ · 現地確認要）"
water_shutoff: "1F キッチン下止水栓（デモ · 現地確認要）"
gas_meter_location: "外構 メーターBOX（デモ）"
first_aid_location: "1F 受付横救急箱"
emergency_contact_property_mgmt: "段燕燕（info@malkk.com）"
ota_backup_contact: "info@malkk.com"
notes: |
  公開情報は kamezawa-public.yaml。本ファイルはゲスト向け PDF・OTA 自動応答にのみ使用。
  清掃: 株式会社墨田クリーンサービス（EXT-003 · ダミー）。
  スマートロック・Wi-Fi パスワード等の L2 値は gitignore 側 kamezawa-secrets.yaml のみに記載。
