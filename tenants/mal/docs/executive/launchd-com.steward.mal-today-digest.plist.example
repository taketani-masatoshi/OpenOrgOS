<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MAL Today digest · 毎日 9:00 / 13:00 / 17:00 JST
     理由: 不動産（土日稼働）+ 別業務（火水含む）→ 週7日
     Install:
       bash tenants/mal/docs/executive/scripts/install-today-digest-launchd.sh
     Canonical script: tenants/mal/docs/executive/scripts/orgos-today-digest.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.steward.mal-today-digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/kk/OS_Steward/tenants/mal/docs/executive/scripts/orgos-today-digest.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/kk/OS_Steward</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ORGOS_TENANT</key>
    <string>mal</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>13</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>17</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/orgos-mal-today-digest.launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/orgos-mal-today-digest.launchd.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
