# mal 本番 — Gmail / email_wire 出荷後に有効化（CEO 承認後）
# Copy fragments into /etc/steward/wire-gateway-mal.env or source after Phase 4a/4b
# Checklist: docs/org-os/gmail-ship-gate-checklist.md

ORGOS_TENANT=mal
PUBLIC_BASE_URL=https://wire.oorgos.org
WIRE_GATEWAY_TLS_TERMINATED_EXTERNALLY=1
ORGOS_STRICT_TRUST=1
ORGOS_REQUIRE_PK_DID=1
ORGOS_STRICT_TLS=1
ORGOS_STRICT_TRANSPORT=1
ORGOS_STRICT_TRUST_JURISDICTIONS=JP
GOV_GATEWAY_TRANSPORT=mock

# Phase 4a 完了 · CEO 承認後に uncomment — prod-wire-gate で email_wire を blocking に
