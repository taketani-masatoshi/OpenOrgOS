# mal Phase 4 — mail / email_wire credentials (L2)
# Copy: cp deploy/mal-pilot/env/mail-wire-mal.env.example deploy/mal-pilot/env/.env.mail-wire
# Load: source deploy/mal-pilot/env/.env.mail-wire  (or phase4 script auto-loads)
# Account: ai@malkk.com only — do not use info@malkk.com for OrgOS wire/mail sync

ORGOS_SMTP_USER=ai@malkk.com
ORGOS_SMTP_PASSWORD=
ORGOS_SMTP_HOST=sv16463.xserver.jp
ORGOS_SMTP_PORT=587
ORGOS_SMTP_SECURE=false

ORGOS_IMAP_USER=ai@malkk.com
ORGOS_IMAP_PASSWORD=
ORGOS_IMAP_HOST=sv16463.xserver.jp
ORGOS_IMAP_PORT=993

# Optional Wire-dedicated SMTP (defaults to ORGOS_SMTP_*)
# ORGOS_WIRE_SMTP_USER=
# ORGOS_WIRE_SMTP_PASSWORD=
