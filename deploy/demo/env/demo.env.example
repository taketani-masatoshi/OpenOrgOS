# OrgOS Demo Docker — local / compose
# Copy to demo.env if you need overrides (gitignored).
# Canonical design: docs/org-os/demo-docker.md

ORGOS_ENV=demo
ORGOS_TENANT=demo
ORGOS_WORKSPACE=/workspace
ORGOS_HOME=/opt/orgos

OPERATOR_CONSOLE_HOST=0.0.0.0
OPERATOR_CONSOLE_PORT=9470

# Demo-friendly: no login wall (localhost only — DO NOT expose publicly)
STEWARD_CHAT_AUTH=0
WIRE_CONSOLE_AUTH=dev
ORGOS_MCP_AUTH=0
ORGOS_LLM_MOCK=1
ORGOS_CSRF=0
ORGOS_RATE_LIMIT=0

# Optional real LLM (overrides mock when set + ORGOS_LLM_MOCK=0)
# OPENAI_API_KEY=
# ORGOS_LLM_MOCK=0
