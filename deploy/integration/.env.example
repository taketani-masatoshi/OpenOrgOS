# OrgOS integration environment — copy to .env and fill in.
# This file is an example only; .env is gitignored and must never be committed.

# Stripe test-mode secret key (sk_test_...). The webhook secret is printed by
# `stripe listen` on startup; copy it into STRIPE_WEBHOOK_SECRET below.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where stripe-cli forwards events. Must match the console you are running.
ORGOS_INTEGRATION_BASE_URL=http://127.0.0.1:9473

# Real SMTP (Mailpit). ORGOS_MAIL_DRY_RUN must be 0 or nothing is sent.
ORGOS_SMTP_HOST=127.0.0.1
ORGOS_SMTP_PORT=1025
ORGOS_MAIL_DRY_RUN=0
ORGOS_MAILPIT_API=http://127.0.0.1:8025

# Estonian eID validation against the self-hosted SiVa JAR.
ORGOS_SIVA_MODE=live
ORGOS_SIVA_BASE_URL=http://127.0.0.1:8080
ORGOS_DIGIDOC_SIDECAR_URL=http://127.0.0.1:9090
ORGOS_DIGIDOC_ALLOW_HTTP_LOOPBACK=1

# Witness Hub bound to a public interface rather than loopback.
ORGOS_HUB_PUBLIC=1
ORGOS_HUB_BIND=0.0.0.0
ORGOS_HUB_PORT=19495
