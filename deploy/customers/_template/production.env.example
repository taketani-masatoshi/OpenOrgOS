# Per-customer production env layout
#
# Copy this example to production.env (gitignored) for each managed customer:
#   deploy/customers/<customer-id>/production.env
#
# Verify:
#   ./scripts/prod-auth-verify.sh <customer-id>
#   ./scripts/customer-mail-drill.sh <customer-id> ops@customer.example
#
# Shared reference (Operator Console defaults):
#   ../../operator-console/env/production.env.example

ORGOS_ENV=production
ORGOS_TENANT=demo
ORGOS_WORKSPACE=/app

# MCP (required in production — ORGOS_MCP_AUTH=0 is commercial-blocked)
ORGOS_MCP_AUTH=1
ORGOS_MCP_TOKEN=

# Auth
STEWARD_CHAT_AUTH=1
WIRE_CONSOLE_AUTH=prod
WIRE_CONSOLE_PROD_ADAPTER=webauthn
WIRE_CONSOLE_ALLOW_DEV_LOGIN=0
ORGOS_COOKIE_SECURE=1
ORGOS_SESSION_PERSIST=1
ORGOS_HUMAN_APPROVAL_SECRET=
ORGOS_SETTLEMENT_CHALLENGE_SECRET=

# WebAuthn RP — must match the customer public HTTPS origin
WIRE_CONSOLE_WEBAUTHN_RP_ID=
WIRE_CONSOLE_WEBAUTHN_ORIGIN=

# SMTP (mail-smtp-drill commercial gate)
ORGOS_MAIL_SMTP_URL=
