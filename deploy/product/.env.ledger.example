# OrgOS Ledger — managed single-tenant env example
# Copy to .env.ledger (gitignored) next to docker-compose.ledger.yaml

ORGOS_TENANT=acme-corp
LEDGER_DATA=/absolute/path/to/tenants/acme-corp
LEDGER_PORT=9470
ORGOS_ENV=production
ORGOS_COOKIE_SECURE=1
WIRE_CONSOLE_WEBAUTHN_RP_ID=ledger.example.com
WIRE_CONSOLE_WEBAUTHN_ORIGIN=https://ledger.example.com

# Stripe billing (P1+) — secrets never committed
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_ACCOUNTANT=price_...
ORGOS_LEDGER_AUTO_PROVISION=1

# After keys are in the process env:
#   orgos ledger product stripe-attest
# Writes product-fleet/stripe-ops.yaml (no secrets)

# Per-tenant HTTP rate limits (mutations / chat)
# ORGOS_RATE_LIMIT_TENANT_MAX=60
# ORGOS_RATE_LIMIT_TENANT_STARTER_MAX=30
# ORGOS_RATE_LIMIT_TENANT_BUSINESS_MAX=60
# ORGOS_RATE_LIMIT_TENANT_ACCOUNTANT_MAX=120
