# Operator Console — production env (copy to production.env, gitignored)
# L2 secrets: set via deploy secrets manager, not committed.

ORGOS_ENV=production
ORGOS_TENANT=demo
ORGOS_WORKSPACE=/app

# Auth
STEWARD_CHAT_AUTH=1
WIRE_CONSOLE_AUTH=prod
WIRE_CONSOLE_PROD_ADAPTER=webauthn
# Never enable on public prod — local docker only (WIRE_CONSOLE_ALLOW_DEV_LOGIN=1)
WIRE_CONSOLE_ALLOW_DEV_LOGIN=0
ORGOS_COOKIE_SECURE=1
ORGOS_SESSION_PERSIST=1
ORGOS_HUMAN_APPROVAL_SECRET=
ORGOS_SETTLEMENT_CHALLENGE_SECRET=

# WebAuthn RP — pick ONE deployment host (must match public HTTPS origin)
# Southwood pilot:
# WIRE_CONSOLE_WEBAUTHN_RP_ID=operator.southwood.inc
# WIRE_CONSOLE_WEBAUTHN_ORIGIN=https://operator.southwood.inc
# oorgos.org (Cloudflare Tunnel operator.oorgos.org → operator-console:9470):
WIRE_CONSOLE_WEBAUTHN_RP_ID=operator.oorgos.org
WIRE_CONSOLE_WEBAUTHN_ORIGIN=https://operator.oorgos.org

# Community → Console SSO (must match Community COMMUNITY_CONSOLE_OIDC_*)
# Prefer WebAuthn in prod; keep OIDC for MyPage handoff (HS256 shared secret).
WIRE_CONSOLE_OIDC_ISSUER=https://community.oorgos.org
WIRE_CONSOLE_OIDC_AUDIENCE=orgos-operator-console
WIRE_CONSOLE_OIDC_HS256_SECRET=
WIRE_CONSOLE_OIDC_ALLOW_HS256=1
# When PROD_ADAPTER=webauthn, Community handoff still uses id_token via /auth/community-handoff


# Operator LLM
OPENAI_API_KEY=

# MCP (optional remote HTTP)
ORGOS_MCP_TOKEN=
ORGOS_MCP_AUTH=1

# Stripe billing (live — commercial claim; secrets via deploy secrets manager)
# Webhook: POST https://<operator-host>/chat/v1/product/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ACCOUNTANT=
ORGOS_LEDGER_AUTO_PROVISION=1

# Witness hub (internal DNS or localhost relay)
# Configure tenant witness-pool.yaml after hub deploy

# Notifications (tenant registry webhook — set in tenants/<id>/steward/platform/notifications/registry.yaml)
