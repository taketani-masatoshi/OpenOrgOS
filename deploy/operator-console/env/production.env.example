# Operator Console — production env (copy to production.env, gitignored)
# L2 secrets: set via deploy secrets manager, not committed.

ORGOS_ENV=production
ORGOS_TENANT=demo
ORGOS_WORKSPACE=/app

# Auth
STEWARD_CHAT_AUTH=1
WIRE_CONSOLE_AUTH=prod
WIRE_CONSOLE_PROD_ADAPTER=webauthn
WEBAUTHN_RP_ID=operator.southwood.inc
WEBAUTHN_ORIGIN=https://operator.southwood.inc
ORGOS_COOKIE_SECURE=1
ORGOS_SESSION_PERSIST=1

# Operator LLM
OPENAI_API_KEY=

# MCP (optional remote HTTP)
ORGOS_MCP_TOKEN=
ORGOS_MCP_AUTH=1

# Witness hub (internal DNS or localhost relay)
# Configure tenant witness-pool.yaml after hub deploy

# Notifications (tenant registry webhook — set in tenants/<id>/steward/platform/notifications/registry.yaml)
