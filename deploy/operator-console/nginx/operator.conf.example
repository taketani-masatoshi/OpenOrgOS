# nginx TLS reverse proxy — copy to deploy/operator-console/nginx/operator.conf
# Mount TLS certs at ./nginx/certs/fullchain.pem and privkey.pem

upstream operator_console {
  server operator-console:9470;
}

server {
  listen 443 ssl http2;
  server_name operator.southwood.inc;

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://operator_console;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }

  location /chat/v1/events/stream {
    proxy_pass http://operator_console;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
  }
}

server {
  listen 80;
  server_name operator.southwood.inc;
  return 301 https://$host$request_uri;
}
