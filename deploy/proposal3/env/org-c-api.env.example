# Generated by: npm run proposal3:tls-init
# Copy to /etc/steward/org-c-api.env and adjust paths for production CA.

ORGOS_TENANT=aiac
PROTOCOL_API_HOST=127.0.0.1
PROTOCOL_API_PORT=9486
PROTOCOL_TLS_CERT=/opt/orgos-reference/data/proposal3-pki/server.pem
PROTOCOL_TLS_KEY=/opt/orgos-reference/data/proposal3-pki/server.key
PROTOCOL_TLS_CA=/opt/orgos-reference/data/proposal3-pki/ca.pem
PROTOCOL_MTLS_REQUIRED=1
PROTOCOL_MTLS_ALLOWED_ORGS=steward://tenant/mal,steward://tenant/southwood
