# Wire Gateway production environment (Mode A — reverse proxy TLS termination)
# Copy to /etc/steward/wire-gateway.env on the operator host.

ORGOS_TENANT=mal
PUBLIC_BASE_URL=https://wire.mal.example
WIRE_GATEWAY_TLS_TERMINATED_EXTERNALLY=1
WIRE_GATEWAY_PUBLIC_BASE_URL=https://wire.mal.example

# Production STRICT gates (orgos doctor --wire-prod)
ORGOS_STRICT_TRUST=1
ORGOS_REQUIRE_PK_DID=1
ORGOS_STRICT_TRUST_JURISDICTIONS=JP
ORGOS_STRICT_TLS=1
ORGOS_STRICT_TRANSPORT=1

# Gov live pilot (set operator sandbox URL/token in shell — do not commit)
GOV_GATEWAY_TRANSPORT=live
# GOV_XROAD_SECURITY_SERVER_URL=https://ss-sandbox.example.ee
# GOV_XROAD_TOKEN=

# Internal API bearer (file path in tenant wire-gateway.yaml)
# WIRE_INTERNAL_BEARER_FILE=tenants/mal/data/protocol/wire-internal.token
