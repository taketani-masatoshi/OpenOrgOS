# Google Calendar push (Phase SEC-3 · gitignore)
# Copy to .env and fill values — never commit .env

GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ACCESS_TOKEN=
# Optional
GOOGLE_CALENDAR_TIMEZONE=Asia/Tokyo

# Gmail API (Secretary send/receive · L2 token: records/executive/gmail-oauth.json)
# GCP Console → OAuth 2.0 Client (Desktop or Web) → redirect: http://localhost:8787/oauth/gmail/callback
ORGOS_GMAIL_CLIENT_ID=
ORGOS_GMAIL_CLIENT_SECRET=
ORGOS_GMAIL_REDIRECT_URI=http://localhost:8787/oauth/gmail/callback

# Community → Operator Console SSO (MyPage Wire／予実 — no second login)
# Must match Community COMMUNITY_CONSOLE_OIDC_* (same HS256 secret)
WIRE_CONSOLE_OIDC_ISSUER=https://community.oorgos.org
WIRE_CONSOLE_OIDC_AUDIENCE=orgos-operator-console
WIRE_CONSOLE_OIDC_HS256_SECRET=
WIRE_CONSOLE_OIDC_ALLOW_HS256=1
