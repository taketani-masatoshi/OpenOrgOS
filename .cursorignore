# Steward OS — AI 自動コンテキスト除外（Git 境界とは別）
# Zone C: 個情 vault — 必要時のみ @file で明示参照
**/records/**

# 試行・一時
scratch/**

# 受信/出力トレイ（スキャン・PDF）— テナント docs
tenants/*/docs/io/inbox/**
tenants/*/docs/io/outbox/**

# 大容量生成物
tenants/*/docs/**/*.pdf
node_modules/**
dist/**

# bank-accounts.yaml / stakeholders.yaml / *-secrets.yaml は意図的に除外しない

# 業務モジュールカタログ — active_context 列挙分のみ @file 参照（token saving）
steward/modules/*/agent.md
steward/modules/*/skills/**
steward/modules/*/seed/**

# ISO テンプレカタログ — standards.yaml 有効分のみ参照
steward/standards/iso/ISO-*/
